# Stage the walkthrough off the first typed command byte so Ghostty becomes
# visible and usable before the deeper write/read/output stops.
breakpoint set --file src/Surface.zig --line 2765

# Teach the closest useful Ghostty-side proof of the PTY-master write handoff.
breakpoint set --file src/termio/Exec.zig --line 457

# Teach where the dedicated PTY read thread starts for exec-backed surfaces.
breakpoint set --file src/termio/Exec.zig --line 1248

# Teach the closest Ghostty-side evidence that the tty/program side emitted
# bytes back across the PTY boundary.
breakpoint set --file src/termio/Exec.zig --line 1298

# Teach the main Termio entrypoint for processing child output.
breakpoint set --file src/termio/Termio.zig --line 678

# Teach where output processing begins parsing and render notification work.
breakpoint set --file src/termio/Termio.zig --line 687

# Teach the actual bulk parser call on the common non-inspector path.
breakpoint set --file src/termio/Termio.zig --line 728

# Teach where the renderer thread responds to a wakeup with frame rebuilding.
breakpoint set --file src/renderer/Thread.zig --line 596

# Teach where the renderer copies terminal-visible state under the mutex.
breakpoint set --file src/renderer/generic.zig --line 1173

# Keep the deeper breakpoints disabled at startup so the Ghostty window can
# become usable and the learner can type the probe command first.
breakpoint disable 2 3 4 5 6 7 8

# When the first typed-input handoff fires, disable it and enable the rest of
# the write/read/render walkthrough.
breakpoint command add 1 -o "breakpoint disable 1" -o "breakpoint enable 2 3 4 5 6 7 8"
